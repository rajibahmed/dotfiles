#!/usr/bin/env bash
# Open (or jump back to) a tmux window that logs into AWS SSO and runs
# `npm run connect` from the tv.vpc-developer-access repo.
#
# Usage:
#   tmux-vpn [PROFILE] [--new]
#     PROFILE   AWS profile, e.g. stg (default) or prd
#     --new     always create a fresh window
#   Each profile gets its own window ("vpn-stg", "vpn-prd").
set -euo pipefail

REPO_DIR="$HOME/Code/tv.vpc-developer-access"
PROFILE="stg"
FORCE_NEW=0

while [[ $# -gt 0 ]]; do
	case "$1" in
	-n | --new)
		FORCE_NEW=1
		;;
	-h | --help)
		sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
		exit 0
		;;
	-*)
		echo "tmux-vpn: unknown argument: $1" >&2
		exit 2
		;;
	*)
		PROFILE="$1"
		;;
	esac
	shift
done

WINDOW_NAME="vpn-$PROFILE"

if [[ -z ${TMUX:-} ]]; then
	echo "tmux-vpn: run this inside tmux" >&2
	exit 1
fi

if [[ ! -d $REPO_DIR ]]; then
	echo "tmux-vpn: repo not found: $REPO_DIR" >&2
	exit 1
fi

if ((!FORCE_NEW)); then
	existing=$(tmux list-windows -F '#{window_name}	#{window_index}' |
		awk -F '\t' -v name="$WINDOW_NAME" '$1 == name { print $2; exit }')
	if [[ -n $existing ]]; then
		tmux select-window -t "$existing"
		exit 0
	fi
fi

# -d keeps focus where it is while the SSO browser flow completes.
win=$(tmux new-window -d -P -F '#{window_id}' -n "$WINDOW_NAME" -c "$REPO_DIR")
tmux set-option -w -t "$win" automatic-rename off

# send-keys (rather than a window command) keeps the shell alive on failure.
tmux send-keys -l -t "$win" \
	"AWS_PROFILE=$PROFILE aws sso login && AWS_PROFILE=$PROFILE npm run connect" \; \
	send-keys -t "$win" Enter
